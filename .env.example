# This file is used automatically only for local development when .env is absent.
# Copy it to .env to customize your local configuration.
# Never use these example JWT secrets in production.
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/tvhub
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
